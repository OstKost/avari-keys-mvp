# Caddyfile для Master-сервера M0 (Россия)
# Домены:
#   m0.vpn.test    -> Frontend SPA + Master Backend API (/api/*)
#   m0api.vpn.test -> Опциональный отдельный домен Master API (:8080)
#   s1.vpn.test    -> Cascade Slave API (:8081)

m0.vpn.test {
    # Проксирование API-запросов к Master Backend
    handle /api/* {
        reverse_proxy localhost:8080
    }

    # Раздача статики React SPA
    handle {
        root * /var/www/avari-keys/frontend
        try_files {path} /index.html
        file_server
    }

    encode gzip zstd
}

# Опционально: отдельный поддомен для Master API
m0api.vpn.test {
    reverse_proxy localhost:8080
    encode gzip zstd
}

# Домен для Cascade Slave API на M0
s1.vpn.test {
    reverse_proxy localhost:8081
    encode gzip zstd
}

