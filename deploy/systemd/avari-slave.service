[Unit]
Description=Avari Keys Slave API Service (AWG Wrapper)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/avari-keys
Environment="SLAVE_PORT=8081"
# Задайте ваш токен или оставьте пустым для автогенерации в лог:
# Environment="SLAVE_API_KEY=your_slave_secret_token_here"
Environment="AWG_SCRIPT_PATH=/root/awg/manage_amneziawg.sh"
Environment="AWG_CONFIGS_DIR=/root/awg/clients"
ExecStart=/usr/local/bin/avari-slave
Restart=always
RestartSec=5s
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
